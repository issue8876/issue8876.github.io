{
  "functions": [
    {
      "source": "functions",
      "codebase": "maeum",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        ".env*",
        "*.log"
      ],
      "predeploy": [
        "node scripts/prepare-firebase.mjs"
      ]
    }
  ],
  "hosting": [
    {
      "public": "dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "predeploy": [
        "node scripts/build-pages.mjs --firebase"
      ],
      "redirects": [
        {
          "source": "/index.html",
          "destination": "/",
          "type": 302
        },
        {
          "source": "/pages/maeum.html",
          "destination": "/",
          "type": 302
        },
        {
          "source": "/pages/maeumgil.html",
          "destination": "/",
          "type": 302
        }
      ],
      "rewrites": [
        {
          "source": "/api/**",
          "function": {
            "functionId": "coachApi",
            "region": "asia-northeast3"
          }
        }
      ],
      "headers": [
        {
          "source": "/api/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-store"
            }
          ]
        },
        {
          "source": "**/*.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "**/*.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "**/*.css",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ],
      "site": "maeum"
    },
    {
      "public": "dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "predeploy": [
        "node scripts/build-pages.mjs --firebase"
      ],
      "redirects": [
        {
          "source": "/",
          "destination": "https://maeum.web.app/",
          "type": 302
        },
        {
          "source": "/index.html",
          "destination": "https://maeum.web.app/",
          "type": 302
        },
        {
          "source": "/pages/maeum.html",
          "destination": "https://maeum.web.app/",
          "type": 302
        },
        {
          "source": "/pages/maeumgil.html",
          "destination": "https://maeum.web.app/",
          "type": 302
        }
      ],
      "rewrites": [
        {
          "source": "/api/**",
          "function": {
            "functionId": "coachApi",
            "region": "asia-northeast3"
          }
        }
      ],
      "headers": [
        {
          "source": "/api/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-store"
            }
          ]
        },
        {
          "source": "**/*.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "**/*.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "**/*.css",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ],
      "site": "maeum-835b3"
    }
  ]
}
