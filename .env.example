# Copy to .env. Never commit .env or put an API key in frontend files.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=low
# Required for API use. Choose 4-6 digits and share privately. No default code.
# Example only: 1234. This code does not verify age or grant provider eligibility.
COACH_JOIN_CODE=
ALLOWED_ORIGINS=https://issue8876.github.io,http://localhost:8787,http://127.0.0.1:8787
PORT=8787
HOST=127.0.0.1
NODE_ENV=development
# Optional public API URL for the Pages build. This is NOT a secret.
PUBLIC_API_BASE_URL=
