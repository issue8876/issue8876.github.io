# Copy to .env. Never commit .env or put an API key in frontend files.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=low
# Required for API use. At least 16 characters; share only with approved users.
COACH_ACCESS_CODE=
ALLOWED_ORIGINS=https://issue8876.github.io,http://localhost:8787,http://127.0.0.1:8787
PORT=8787
HOST=127.0.0.1
NODE_ENV=development
# Optional public API URL for the Pages build. This is NOT a secret.
PUBLIC_API_BASE_URL=
